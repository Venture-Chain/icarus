# Data Sources
FINNHUB_API_KEY=your_finnhub_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret

# Database (defaults work for local dev)
DATABASE_URL=postgresql://icarus:icarus@timescaledb:5432/icarus
REDIS_URL=redis://redis:6379

# Trading
LIVE_TRADING_ENABLED=false

# Multi-broker orchestration (JSON array of account configs, empty = IB default)
# Example: [{"id":"ib-paper","broker":"ib","mode":"paper","host":"ib-gateway","port":4003},{"id":"alpaca-paper","broker":"alpaca","mode":"paper","key_field":"alpaca_paper_api_key","secret_field":"alpaca_paper_api_secret"}]
BROKER_ACCOUNTS=[]
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# Quantum Integration
QUANTUM_ENABLED=false